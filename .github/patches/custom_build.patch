+// Build-time values come from the environment (build-clients.yml exports them).
+// option_env! + const helpers mirror the compose ${VAR:-default} semantics, so
+// no secret is ever baked into this patch and no sed is needed. The helpers
+// avoid const-unstable .unwrap_or, so they compile on any MSRV.
+const fn __rd_str(opt: Option<&str>) -> &str {
+    match opt { Some(v) => v, None => "" }
+}
+const fn __rd_port(opt: Option<&str>, default: &str) -> i32 {
+    let s = match opt { Some(v) => v, None => default };
+    let b = s.as_bytes();
+    let mut v = 0i32;
+    let mut i = 0usize;
+    while i < b.len() {
+        v = v * 10 + (b[i] - b'0') as i32;
+        i += 1;
+    }
+    v
+}
